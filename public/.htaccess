# Canonical host: HTTPS + non-www
<IfModule mod_rewrite.c>
	RewriteEngine On

	# www → apex HTTPS (non-www canonical)
	RewriteCond %{HTTP_HOST} ^www\.besttarkovcheats\.com$ [NC]
	RewriteRule ^ https://besttarkovcheats.com%{REQUEST_URI} [L,R=301,NE]

	# http → https apex (direct or via proxy)
	RewriteCond %{HTTPS} !=on [OR]
	RewriteCond %{HTTP:X-Forwarded-Proto} !https
	RewriteRule ^ https://besttarkovcheats.com%{REQUEST_URI} [L,R=301,NE]
</IfModule>

<IfModule mod_headers.c>
	Header set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
	Header set X-Content-Type-Options "nosniff"
	Header set Referrer-Policy "strict-origin-when-cross-origin"
	<FilesMatch "\.(html|htm)$">
		Header set Content-Type "text/html; charset=utf-8"
	</FilesMatch>
</IfModule>

AddDefaultCharset utf-8
