---
import { getUi } from '../data/i18n';
import { defaultLocale, type LocaleCode } from '../data/i18n/locales';
import { getT } from '../i18n/server';

interface Props {
	locale?: LocaleCode;
}

const locale = Astro.props.locale ?? defaultLocale;
const trust = getUi(locale).trust;
const t = getT(locale);
---

<section class="trust-bar shell" aria-label={t('common.packageStatus')}>
	<p class="trust-bar__text">
		<strong>{trust.status}</strong>
		<span aria-hidden="true">·</span>
		{trust.delivery}
		<span aria-hidden="true">·</span>
		{trust.platform}
		<span aria-hidden="true">·</span>
		{trust.antiCheatShort ?? trust.antiCheat}
	</p>
</section>

<style>
	.trust-bar {
		padding-block: 0.75rem;
		border-bottom: 1px solid var(--color-border);
	}

	.trust-bar__text {
		margin: 0;
		font-size: 0.875rem;
		color: var(--color-muted);
		text-align: center;
		line-height: 1.5;
	}

	.trust-bar__text strong {
		color: var(--ok);
		font-weight: 600;
	}

	.trust-bar__text span {
		margin-inline: 0.35rem;
		opacity: 0.4;
	}
</style>
