---
import { getUi } from '../data/i18n';
import { getLocalizedPath } from '../data/i18n/routing';
import { defaultLocale, type LocaleCode } from '../data/i18n/locales';
import { getBlogBasePath } from '../data/blog/helpers';
import { siteConfig } from '../data/site'; interface Props { locale?: LocaleCode;
} const locale = Astro.props.locale ?? defaultLocale;
const ui = getUi(locale); const explore = [ { label: ui.nav.hacks ?? 'Hacks', href: getLocalizedPath('hacks', locale) }, { label: ui.nav.esp, href: getLocalizedPath('delta-force-esp', locale) }, { label: ui.nav.aimbot, href: getLocalizedPath('delta-force-aimbot', locale) }, { label: ui.nav.features, href: getLocalizedPath('features', locale) }, { label: ui.nav.pricing, href: getLocalizedPath('pricing', locale) }, { label: ui.nav.faq, href: getLocalizedPath('faq', locale) }, { label: 'Blog', href: getBlogBasePath(locale) },
]; const help = [ { label: ui.nav.setup, href: getLocalizedPath('setup', locale) }, { label: ui.nav.updates, href: getLocalizedPath('updates', locale) }, { label: 'Reviews', href: '/reviews/' }, { label: 'Support', href: getLocalizedPath('support', locale) }, { label: 'Privacy', href: getLocalizedPath('privacy', locale) }, { label: 'Terms', href: getLocalizedPath('terms', locale) },
];
--- <footer class="site-footer"> <div class="shell site-footer__grid"> <div> <a href={getLocalizedPath('home', locale)} class="site-footer__brand">{siteConfig.name}</a> <p>{ui.footer.tagline.split('\n')[0]}</p> </div> <div> <p class="site-footer__label">{ui.footer.explore}</p> <ul> {explore.map((link) => <li><a href={link.href}>{link.label}</a></li>)} </ul> </div> <div> <p class="site-footer__label">{ui.footer.help}</p> <ul> {help.map((link) => <li><a href={link.href}>{link.label}</a></li>)} <li><a href={`mailto:${siteConfig.supportEmail}`}>{siteConfig.supportEmail}</a></li> </ul> </div> </div> <div class="shell site-footer__bottom"> <p>© {new Date().getFullYear()} {siteConfig.name}</p> </div>
</footer> <style>.site-footer { background: var(--bg-panel); border-top: 1px solid var(--line-soft); padding-top: 3rem; }.site-footer__grid { display: grid; grid-template-columns: 1.5fr 1fr 1fr; gap: 2rem; padding-bottom: 2.25rem; }.site-footer__brand { display: inline-block; margin-bottom: 0.65rem; font-family: var(--font-display); font-size: 1.2rem; font-weight: 700; letter-spacing: -0.03em; color: var(--ink); }.site-footer__brand:hover { color: var(--magenta-soft); }.site-footer p { margin: 0; font-size: 0.875rem; line-height: 1.55; color: var(--ink-faint); max-width: 20rem; }.site-footer__label { margin: 0 0 0.85rem !important; font-size: 0.75rem !important; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-muted) !important; }.site-footer ul { margin: 0; padding: 0; list-style: none; display: grid; gap: 0.45rem; }.site-footer a:not(.site-footer__brand) { font-size: 0.875rem; color: var(--ink-muted); }.site-footer a:not(.site-footer__brand):hover { color: var(--ink); }.site-footer__bottom { border-top: 1px solid var(--line-soft); padding: 1.1rem 0 1.6rem; }.site-footer__bottom p { max-width: none; font-size: 0.75rem; } @media (max-width: 760px) {.site-footer__grid { grid-template-columns: 1fr; gap: 1.75rem; }.site-footer a:not(.site-footer__brand) { display: inline-flex; align-items: center; min-height: var(--touch-min, 2.75rem); overflow-wrap: anywhere; }.site-footer__bottom { padding-bottom: max(1.35rem, var(--safe-bottom, env(safe-area-inset-bottom, 0px))); } }
</style>
