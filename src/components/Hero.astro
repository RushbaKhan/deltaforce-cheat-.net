---
import type { LocaleCode } from '../data/i18n/locales';
import { defaultLocale } from '../data/i18n/locales';
import { getUi } from '../data/i18n';
import { productInfo, siteConfig } from '../data/site';
import { brandCopy } from '../data/site-core';
import { fillBrandTokens } from '../data/brand';
import { heroWidth, heroHeight, heroSrcSet, heroSizes, heroSrc } from '../lib/responsive-images';

interface Props {
	locale?: LocaleCode;
}

const locale = Astro.props.locale ?? defaultLocale;
const ui = getUi(locale);
const isEnglish = locale === 'en';

const monthly = productInfo.plans.find((p) => p.id === 'monthly') ?? productInfo.plans[0];
const ctaBuy = isEnglish ? fillBrandTokens(brandCopy.ctaBuy) : ui.hero.buyNow;
/** Brand stays editable on EN; other locales use translated hero title. */
const heroTitle = isEnglish ? siteConfig.name : ui.hero.accent;
const heroSubtitle = isEnglish ? productInfo.heroLede : ui.hero.subtitle;

const fromByLocale: Partial<Record<LocaleCode, string>> = {
	en: 'from',
	es: 'desde',
	fr: 'à partir de',
	de: 'ab',
	pt: 'a partir de',
	it: 'da',
	nl: 'vanaf',
	pl: 'od',
	ru: 'от',
	tr: 'başlayan',
	ar: 'من',
	ja: '',
	ko: '',
	zh: '',
	hi: 'से',
	id: 'dari',
	th: 'เริ่ม',
	vi: 'từ',
	uk: 'від',
	cs: 'od',
	ro: 'de la',
	sv: 'från',
};
const priceFrom = fromByLocale[locale] ?? 'from';
const priceLabel = priceFrom ? `${priceFrom} $${monthly.price}` : `$${monthly.price}`;

const chipLabelsByLocale: Partial<Record<LocaleCode, [string, string, string, string]>> = {
	en: [
		fillBrandTokens(brandCopy.chipEsp),
		fillBrandTokens(brandCopy.chipAim),
		fillBrandTokens(brandCopy.chipRadar),
		fillBrandTokens(brandCopy.chipUpdates),
	],
	es: ['ESP / wallhack', 'Soft aim', 'Radar 2D', 'Actualizaciones'],
	fr: ['ESP / wallhack', 'Soft aim', 'Radar 2D', 'Mises à jour'],
	de: ['ESP / Wallhack', 'Soft Aim', '2D-Radar', 'Updates'],
	pt: ['ESP / wallhack', 'Soft aim', 'Radar 2D', 'Atualizações'],
	it: ['ESP / wallhack', 'Soft aim', 'Radar 2D', 'Aggiornamenti'],
	nl: ['ESP / wallhack', 'Soft aim', '2D-radar', 'Updates'],
	pl: ['ESP / wallhack', 'Soft aim', 'Radar 2D', 'Aktualizacje'],
	ru: ['ESP / wallhack', 'Soft aim', '2D радар', 'Обновления'],
	tr: ['ESP / wallhack', 'Soft aim', '2D radar', 'Güncellemeler'],
	ar: ['ESP / wallhack', 'Soft aim', 'رادار 2D', 'تحديثات'],
	ja: ['ESP / ウォールハック', 'ソフトエイム', '2Dレーダー', 'パッチ更新'],
	ko: ['ESP / 월핵', '소프트 에임', '2D 레이더', '패치 업데이트'],
	zh: ['ESP / 透视', '软锁定', '2D 雷达', '补丁更新'],
	hi: ['ESP / wallhack', 'Soft aim', '2D रडार', 'अपडेट'],
	id: ['ESP / wallhack', 'Soft aim', 'Radar 2D', 'Pembaruan'],
	th: ['ESP / wallhack', 'Soft aim', 'เรดาร์ 2D', 'อัปเดต'],
	vi: ['ESP / wallhack', 'Soft aim', 'Radar 2D', 'Cập nhật'],
	uk: ['ESP / wallhack', 'Soft aim', '2D радар', 'Оновлення'],
	cs: ['ESP / wallhack', 'Soft aim', '2D radar', 'Aktualizace'],
	ro: ['ESP / wallhack', 'Soft aim', 'Radar 2D', 'Actualizări'],
	sv: ['ESP / wallhack', 'Soft aim', '2D-radar', 'Uppdateringar'],
};
const chipLabels = chipLabelsByLocale[locale] ?? chipLabelsByLocale.en!;
const chips = [
	{ key: 'chipEsp', label: chipLabels[0] },
	{ key: 'chipAim', label: chipLabels[1] },
	{ key: 'chipRadar', label: chipLabels[2] },
	{ key: 'chipUpdates', label: chipLabels[3] },
] as const;

---

<section class="hero" aria-label={heroTitle}>
	<div class="hero__media" aria-hidden="true">
		{/* PNG master only — no lossy WebP compression on the hero */}
		<img
			src={heroSrc}
			srcset={heroSrcSet}
			sizes={heroSizes}
			alt={siteConfig.name}
			width={heroWidth}
			height={heroHeight}
			fetchpriority="high"
			loading="eager"
			decoding="async"
		/>
	</div>
	<div class="hero__veil" aria-hidden="true"></div>

	<div class="shell hero__content">
		<div class="hero__copy">
			{
				isEnglish ? (
					<>
						{/* Full SEO H1 for crawlers; visually hidden so hero stays design-clean */}
						<h1 class="sr-only">{siteConfig.name} — Undetected ESP, Wallhack &amp; Aimbot</h1>
						<p class="hero__brand" aria-hidden="true">
							<span data-edit="name">{heroTitle}</span>
						</p>
					</>
				) : (
					<h1 class="hero__brand">{heroTitle}</h1>
				)
			}
			<p class="hero__lede" data-edit={isEnglish ? 'heroLede' : undefined}>{heroSubtitle}</p>
			<div class="hero__actions">
				<a class="hero__buy" href={siteConfig.checkoutUrl} rel="noopener noreferrer">
					<svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
						<path
							d="M4.5 6.5h2.1l1.2 9.2h9.4l1.8-6.6H8.1M9.2 19.2a.9.9 0 100-1.8.9.9 0 000 1.8zm7.4 0a.9.9 0 100-1.8.9.9 0 000 1.8z"
							stroke="currentColor"
							stroke-width="1.7"
							stroke-linecap="round"
							stroke-linejoin="round"
						/>
					</svg>
					<span class="hero__buy-label" data-edit={isEnglish ? 'ctaBuy' : undefined}>{ctaBuy}</span>
					<span class="hero__buy-price">{priceLabel}</span>
				</a>
			</div>
			<ul class="hero__features">
				{
					chips.map((chip) => (
						<li>
							<svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
								{chip.key === 'chipEsp' && (
									<>
										<circle cx="12" cy="12" r="7.5" stroke="currentColor" stroke-width="1.6" />
										<path
											d="M12 8.5v3.2L14.2 14"
											stroke="currentColor"
											stroke-width="1.6"
											stroke-linecap="round"
										/>
									</>
								)}
								{chip.key === 'chipAim' && (
									<path
										d="M12 4.5l1.7 4.8H19l-4 3.1 1.5 4.8L12 14.8 7.5 17.2 9 12.4 5 9.3h5.3L12 4.5z"
										stroke="currentColor"
										stroke-width="1.5"
										stroke-linejoin="round"
									/>
								)}
								{chip.key === 'chipRadar' && (
									<>
										<circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.6" />
										<circle cx="12" cy="12" r="7.5" stroke="currentColor" stroke-width="1.6" />
										<path
											d="M12 2.8v2.2M12 19v2.2M2.8 12h2.2M19 12h2.2"
											stroke="currentColor"
											stroke-width="1.6"
											stroke-linecap="round"
										/>
									</>
								)}
								{chip.key === 'chipUpdates' && (
									<path
										d="M5 13.2l4.2 4.2L19 7.6"
										stroke="currentColor"
										stroke-width="1.8"
										stroke-linecap="round"
										stroke-linejoin="round"
									/>
								)}
							</svg>
							<span data-edit={isEnglish ? chip.key : undefined}>{chip.label}</span>
						</li>
					))
				}
			</ul>
		</div>
	</div>
</section>

<style>
	.hero {
		--hero-pad-y: clamp(1rem, 2vw, 1.75rem);
		--hero-stack: clamp(0.5rem, 1.1vw, 0.75rem);
		/*
		 * Bar is a bit shorter than the native 1024/409 (~2.5:1) art.
		 * Image stays undistorted via object-fit: cover (crops edges, no squash).
		 */
		--hero-ratio: 3.15 / 1;
		position: relative;
		isolation: isolate;
		display: grid;
		align-items: center;
		overflow: hidden;
		background: #050506;
		aspect-ratio: var(--hero-ratio);
		width: 100%;
		height: auto;
		min-height: 0;
		max-height: none;
	}

	.hero__media {
		position: absolute;
		inset: 0;
		z-index: 0;
	}

	.hero__media picture,
	.hero__media img {
		display: block;
		width: 100%;
		height: 100%;
	}

	.hero__media img {
		/* Cover = keep proportions; crop top/bottom of the shorter bar */
		object-fit: cover;
		/* Prefer a bit higher in the frame so the operator stays in view */
		object-position: right 28%;
		image-rendering: auto;
		transform: translateZ(0);
		animation: hero-in 0.9s ease-out both;
	}

	.hero__veil {
		position: absolute;
		inset: 0;
		z-index: 1;
		pointer-events: none;
		background: linear-gradient(
			90deg,
			rgba(5, 5, 6, 0.78) 0%,
			rgba(5, 5, 6, 0.52) 34%,
			rgba(5, 5, 6, 0.18) 58%,
			transparent 74%
		);
	}

	.hero__content {
		position: relative;
		z-index: 2;
		padding-block: var(--hero-pad-y);
		align-self: center;
		/* Sit a touch above true center so title reads mid-image */
		transform: translateY(clamp(-1.5rem, -3vw, -0.35rem));
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		justify-items: start;
		box-sizing: border-box;
	}

	.hero__copy {
		display: flex;
		flex-direction: column;
		align-items: stretch;
		gap: var(--hero-stack);
		width: min(100%, 28rem);
		max-width: 100%;
		min-width: 0;
		margin: 0;
		padding: 0;
		animation: rise 0.65s ease-out both;
	}

	.hero__brand {
		margin: 0;
		font-family: var(--font-sans);
		font-size: clamp(2.1rem, 4.4vw, 3.25rem);
		font-weight: 700;
		line-height: 1.12;
		letter-spacing: -0.03em;
		overflow-wrap: anywhere;
		color: #fff;
		width: 100%;
		text-transform: uppercase;
	}

	.hero__lede {
		margin: 0;
		width: 100%;
		max-width: none;
		font-size: clamp(0.95rem, 1.5vw, 1.05rem);
		line-height: 1.5;
		color: color-mix(in srgb, #fff 74%, var(--ink-muted));
	}

	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.7rem;
		margin: 0;
		width: 100%;
	}

	.hero__buy {
		display: inline-flex;
		align-items: center;
		justify-content: flex-start;
		gap: 0.55rem;
		width: auto;
		max-width: 100%;
		min-height: 3rem;
		padding: 0.55rem 0.55rem 0.55rem 1.05rem;
		border-radius: 999px;
		background: #fff;
		color: #09090b;
		font-size: 0.9375rem;
		font-weight: 700;
		letter-spacing: -0.015em;
		box-shadow:
			0 1px 0 color-mix(in srgb, #fff 70%, transparent) inset,
			0 10px 28px rgba(0, 0, 0, 0.28);
		transition:
			transform 0.18s ease,
			background 0.18s ease,
			box-shadow 0.18s ease;
	}

	.hero__buy svg {
		width: 1.05rem;
		height: 1.05rem;
		flex-shrink: 0;
		opacity: 0.85;
	}

	.hero__buy-label {
		padding-right: 0.15rem;
	}

	.hero__buy-price {
		display: inline-flex;
		align-items: center;
		min-height: 2rem;
		margin-left: auto;
		padding: 0 0.85rem;
		border-radius: 999px;
		background: #09090b;
		color: #fff;
		font-size: 0.8125rem;
		font-weight: 700;
		letter-spacing: -0.01em;
	}

	.hero__buy:hover {
		background: #f4f4f5;
		color: #09090b;
		transform: translateY(-2px);
		box-shadow:
			0 1px 0 color-mix(in srgb, #fff 70%, transparent) inset,
			0 14px 32px rgba(0, 0, 0, 0.34);
	}

	.hero__buy:hover .hero__buy-price {
		background: var(--magenta);
	}

	.hero__buy:active {
		transform: translateY(0);
	}

	.hero__features {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		column-gap: 1rem;
		row-gap: 0.55rem;
		margin: 0;
		padding: 0;
		list-style: none;
		width: 100%;
		max-width: none;
	}

	.hero__features li {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		min-width: 0;
		font-size: 0.8125rem;
		font-weight: 500;
		line-height: 1.3;
		color: color-mix(in srgb, #fff 72%, transparent);
	}

	.hero__features li span {
		min-width: 0;
	}

	.hero__features svg {
		width: 1rem;
		height: 1rem;
		flex-shrink: 0;
		color: var(--magenta-soft);
	}

	@keyframes rise {
		from {
			opacity: 0;
			transform: translateY(10px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@keyframes hero-in {
		from {
			opacity: 0.7;
		}
		to {
			opacity: 1;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero__copy,
		.hero__media img {
			animation: none;
		}

		.hero__buy,
		.hero__buy:hover {
			transition: none;
			transform: none;
		}

		.hero__content {
			transform: translateY(clamp(-1.5rem, -3vw, -0.35rem));
		}
	}

	/*
	 * Phones / small tablets: stop using the ultra-wide 3.15:1 bar.
	 * That ratio collapses to ~120px tall on a 390px phone and clips the CTA.
	 * Mobile = taller full-bleed panel; height grows with copy.
	 */
	@media (max-width: 900px) {
		.hero {
			aspect-ratio: auto;
			min-height: 0;
			max-height: none;
			height: auto;
			display: block;
			overflow: hidden;
		}

		.hero__media img {
			object-fit: cover;
			object-position: 78% 10%;
		}

		.hero__veil {
			background: linear-gradient(
				180deg,
				rgba(5, 5, 6, 0.28) 0%,
				rgba(5, 5, 6, 0.52) 42%,
				rgba(5, 5, 6, 0.9) 78%,
				rgba(5, 5, 6, 0.96) 100%
			);
		}

		.hero__content {
			transform: none;
			width: 100%;
			min-height: clamp(18.5rem, 56svh, 28rem);
			display: flex;
			align-items: flex-end;
			padding-block: 1.35rem 1.2rem;
			padding-bottom: max(1.2rem, env(safe-area-inset-bottom, 0px));
			box-sizing: border-box;
		}

		.hero__copy {
			width: 100%;
			max-width: 28rem;
			gap: 0.65rem;
		}

		.hero__brand {
			font-size: clamp(1.7rem, 7.5vw, 2.35rem);
			line-height: 1.08;
		}

		.hero__lede {
			display: block;
			overflow: visible;
			-webkit-line-clamp: unset;
			font-size: clamp(0.9rem, 3.6vw, 1rem);
			max-width: 34ch;
			color: color-mix(in srgb, #fff 80%, var(--ink-muted));
		}

		.hero__actions {
			width: 100%;
		}

		.hero__buy {
			width: 100%;
			max-width: 22rem;
			min-height: var(--touch-min, 2.75rem);
			font-size: 0.9375rem;
			justify-content: flex-start;
		}

		.hero__buy-price {
			margin-left: auto;
		}

		.hero__features {
			display: grid;
			grid-template-columns: repeat(2, minmax(0, 1fr));
			column-gap: 0.75rem;
			row-gap: 0.45rem;
			max-width: 22rem;
		}

		.hero__features li {
			font-size: 0.78rem;
		}
	}

	@media (max-width: 480px) {
		.hero__content {
			min-height: clamp(17.5rem, 60svh, 26rem);
			padding-block: 1.2rem 1.1rem;
		}

		.hero__brand {
			font-size: clamp(1.55rem, 8.2vw, 1.95rem);
		}

		.hero__lede {
			max-width: none;
		}

		.hero__buy {
			width: 100%;
			max-width: none;
		}

		.hero__features {
			max-width: none;
		}
	}

	@media (max-width: 360px) {
		.hero__content {
			min-height: clamp(16.5rem, 64svh, 24rem);
		}

		.hero__brand {
			font-size: 1.45rem;
		}

		.hero__features {
			grid-template-columns: 1fr;
			row-gap: 0.35rem;
		}
	}

	@media (max-width: 900px) and (orientation: landscape) and (max-height: 480px) {
		.hero__content {
			min-height: min(70svh, 16.5rem);
			padding-block: 0.85rem 0.8rem;
		}

		.hero__lede {
			display: -webkit-box;
			-webkit-box-orient: vertical;
			-webkit-line-clamp: 2;
			overflow: hidden;
			font-size: 0.85rem;
		}

		.hero__features {
			display: none;
		}

		.hero__buy {
			max-width: 20rem;
		}
	}
</style>
