---
import type { LocaleCode } from '../data/i18n/locales';
import { productInfo, siteConfig } from '../data/site';
import { brandCopy } from '../data/site-core';
import { fillBrandTokens } from '../data/brand';
import { heroWidth, heroHeight, heroSrcSet, heroSizes } from '../lib/responsive-images'; interface Props { locale?: LocaleCode;
} const monthly = productInfo.plans.find((p) => p.id === 'monthly') ?? productInfo.plans[0];
const ctaBuy = fillBrandTokens(brandCopy.ctaBuy);
const chips = [ { key: 'chipEsp', label: fillBrandTokens(brandCopy.chipEsp) }, { key: 'chipAim', label: fillBrandTokens(brandCopy.chipAim) }, { key: 'chipRadar', label: fillBrandTokens(brandCopy.chipRadar) }, { key: 'chipUpdates', label: fillBrandTokens(brandCopy.chipUpdates) },
] as const;
--- <section class="hero" aria-label={siteConfig.name}> <div class="hero__media" aria-hidden="true"> <picture> <source srcset={heroSrcSet} sizes={heroSizes} type="image/webp" /> <img src="/images/hero-banner.png" alt="" width={heroWidth} height={heroHeight} fetchpriority="high" loading="eager" decoding="sync" /> </picture> </div> <div class="hero__veil" aria-hidden="true"></div> <div class="shell hero__content"> <div class="hero__copy"> <h1 class="hero__brand" data-edit="name">{siteConfig.name}</h1> <p class="hero__lede" data-edit="heroLede">{productInfo.heroLede}</p> <div class="hero__actions"> <a class="hero__buy" href={siteConfig.checkoutUrl} rel="noopener noreferrer"> <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"> <path d="M4.5 6.5h2.1l1.2 9.2h9.4l1.8-6.6H8.1M9.2 19.2a.9.9 0 100-1.8.9.9 0 000 1.8zm7.4 0a.9.9 0 100-1.8.9.9 0 000 1.8z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /> </svg> <span class="hero__buy-label" data-edit="ctaBuy">{ctaBuy}</span> <span class="hero__buy-price">from ${monthly.price}</span> </a> </div> <ul class="hero__features"> { chips.map((chip) => ( <li> <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"> {chip.key === 'chipEsp' && ( <> <circle cx="12" cy="12" r="7.5" stroke="currentColor" stroke-width="1.6" /> <path d="M12 8.5v3.2L14.2 14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /> </> )} {chip.key === 'chipAim' && ( <path d="M12 4.5l1.7 4.8H19l-4 3.1 1.5 4.8L12 14.8 7.5 17.2 9 12.4 5 9.3h5.3L12 4.5z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" /> )} {chip.key === 'chipRadar' && ( <> <circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.6" /> <circle cx="12" cy="12" r="7.5" stroke="currentColor" stroke-width="1.6" /> <path d="M12 2.8v2.2M12 19v2.2M2.8 12h2.2M19 12h2.2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /> </> )} {chip.key === 'chipUpdates' && ( <path d="M5 13.2l4.2 4.2L19 7.6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /> )} </svg> <span data-edit={chip.key}>{chip.label}</span> </li> )) } </ul> </div> </div>
</section> <style>.hero { --hero-pad-y: clamp(2rem, 4vw, 3rem); --hero-stack: clamp(0.7rem, 1.6vw, 0.9rem); position: relative; isolation: isolate; display: grid; align-items: center; overflow: hidden; background: #050506; /* Match banner ratio so cover doesn't crop/zoom the art */ aspect-ratio: 1024 / 364; width: 100%; min-height: clamp(14rem, 30vw, 22rem); height: auto; }.hero__media { position: absolute; inset: 0; z-index: 0; }.hero__media picture,.hero__media img { display: block; width: 100%; height: 100%; }.hero__media img { object-fit: contain; object-position: right center; backface-visibility: hidden; transform: translateZ(0); animation: hero-in 0.9s ease-out both; }.hero__veil { position: absolute; inset: 0; z-index: 1; pointer-events: none; background: linear-gradient( 90deg, rgba(5, 5, 6, 0.78) 0%, rgba(5, 5, 6, 0.52) 34%, rgba(5, 5, 6, 0.18) 58%, transparent 74% ); }.hero__content { position: relative; z-index: 2; padding-block: var(--hero-pad-y); align-self: center; /* Sit a touch above true center so title reads mid-image */ transform: translateY(clamp(-1.5rem, -3vw, -0.35rem)); display: grid; grid-template-columns: minmax(0, 1fr); justify-items: start; box-sizing: border-box; }.hero__copy { display: flex; flex-direction: column; align-items: stretch; gap: var(--hero-stack); width: min(100%, 28rem); max-width: 100%; min-width: 0; margin: 0; padding: 0; animation: rise 0.65s ease-out both; }.hero__brand { margin: 0; font-family: var(--font-sans); font-size: clamp(2.1rem, 4.4vw, 3.25rem); font-weight: 700; line-height: 1.12; letter-spacing: -0.03em; overflow-wrap: anywhere; color: #fff; width: 100%; }.hero__lede { margin: 0; width: 100%; max-width: none; font-size: clamp(0.95rem, 1.5vw, 1.05rem); line-height: 1.5; color: color-mix(in srgb, #fff 74%, var(--ink-muted)); }.hero__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 0.7rem; margin: 0; width: 100%; }.hero__buy { display: inline-flex; align-items: center; justify-content: flex-start; gap: 0.55rem; width: auto; max-width: 100%; min-height: 3rem; padding: 0.55rem 0.55rem 0.55rem 1.05rem; border-radius: 999px; background: #fff; color: #09090b; font-size: 0.9375rem; font-weight: 700; letter-spacing: -0.015em; box-shadow: 0 1px 0 color-mix(in srgb, #fff 70%, transparent) inset, 0 10px 28px rgba(0, 0, 0, 0.28); transition: transform 0.18s ease, background 0.18s ease, box-shadow 0.18s ease; }.hero__buy svg { width: 1.05rem; height: 1.05rem; flex-shrink: 0; opacity: 0.85; }.hero__buy-label { padding-right: 0.15rem; }.hero__buy-price { display: inline-flex; align-items: center; min-height: 2rem; margin-left: auto; padding: 0 0.85rem; border-radius: 999px; background: #09090b; color: #fff; font-size: 0.8125rem; font-weight: 700; letter-spacing: -0.01em; }.hero__buy:hover { background: #f4f4f5; color: #09090b; transform: translateY(-2px); box-shadow: 0 1px 0 color-mix(in srgb, #fff 70%, transparent) inset, 0 14px 32px rgba(0, 0, 0, 0.34); }.hero__buy:hover.hero__buy-price { background: var(--magenta); }.hero__buy:active { transform: translateY(0); }.hero__features { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 1rem; row-gap: 0.55rem; margin: 0; padding: 0; list-style: none; width: 100%; max-width: none; }.hero__features li { display: flex; align-items: center; gap: 0.5rem; min-width: 0; font-size: 0.8125rem; font-weight: 500; line-height: 1.3; color: color-mix(in srgb, #fff 72%, transparent); }.hero__features li span { min-width: 0; }.hero__features svg { width: 1rem; height: 1rem; flex-shrink: 0; color: var(--magenta-soft); } @keyframes rise { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } } @keyframes hero-in { from { opacity: 0.7; } to { opacity: 1; } } @media (prefers-reduced-motion: reduce) {.hero__copy,.hero__media img { animation: none; }.hero__buy,.hero__buy:hover { transition: none; transform: none; }.hero__content { transform: translateY(clamp(-1.5rem, -3vw, -0.35rem)); } } @media (max-width: 900px) {.hero { min-height: clamp(13rem, 34vw, 20rem); max-height: none; } } @media (max-width: 760px) {.hero { aspect-ratio: 1024 / 364; min-height: clamp(12rem, 42vw, 18rem); max-height: none; display: flex; flex-direction: column; justify-content: flex-end; }.hero__media img { object-fit: contain; object-position: right center; }.hero__veil { background: linear-gradient( 180deg, rgba(5, 5, 6, 0.08) 0%, rgba(5, 5, 6, 0.28) 32%, rgba(5, 5, 6, 0.82) 68%, rgba(5, 5, 6, 0.96) 100% ); }.hero__content { transform: none; padding-top: 1.25rem; padding-bottom: max(1.5rem, var(--safe-bottom, env(safe-area-inset-bottom, 0px))); }.hero__copy { width: 100%; gap: 0.65rem; }.hero__brand { font-size: clamp(1.85rem, 8vw, 2.5rem); }.hero__lede { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; font-size: 0.95rem; }.hero__buy { width: 100%; justify-content: flex-start; min-height: var(--touch-min, 2.75rem); }.hero__features li { min-height: 2.25rem; align-items: flex-start; }.hero__features li span { overflow-wrap: anywhere; } } @media (max-width: 480px) {.hero { min-height: clamp(11rem, 38vw, 16rem); }.hero__brand { font-size: clamp(1.7rem, 8.5vw, 2.15rem); }.hero__buy { flex-wrap: wrap; row-gap: 0.35rem; }.hero__buy-price { margin-left: 0; }.hero__features { column-gap: 0.65rem; row-gap: 0.35rem; } } @media (max-width: 360px) {.hero__features { grid-template-columns: 1fr; } } @media (max-height: 480px) and (orientation: landscape) {.hero { min-height: auto; padding-block: 0.75rem; }.hero__features { display: none; }.hero__lede { -webkit-line-clamp: 1; } }
</style>
