---
import PageLayout from '../layouts/PageLayout.astro';
import { getPageContent, type PageId } from '../data/i18n';
import { getLocalizedPath, localizeInternalHref } from '../data/i18n/routing';
import type { LocaleCode } from '../data/i18n/locales';
import { productInfo, seoFaqs, siteConfig } from '../data/site';
import { absoluteFaqUrl, getFaqPath } from '../data/faq';
import { deltaForceImages } from '../data/delta-force';
import { simplePageCopy } from '../data/i18n/simple-pages'; interface Props { locale: LocaleCode; pageId: PageId;
} const { locale, pageId } = Astro.props;
const page = getPageContent(locale, pageId);
const simple = locale === 'en' ? simplePageCopy[pageId] : undefined; function localizeParagraphHtml(html: string): string { return html.replace(/\{checkout\}/g, siteConfig.checkoutUrl).replace(/href="(\/[^"]+)"/g, (_, path: string) => `href="${localizeInternalHref(path, locale)}"`);
} const heading = simple?.h1 ?? page.h1;
const intro = simple?.intro ?? page.intro;
const sections = simple?.sections ?? page.sections;
const ctaPrimaryLabel = simple?.ctaPrimary ?? page.ctaPrimary;
const ctaSecondaryLabel = simple?.ctaSecondary ?? page.ctaSecondary;
const ctaSecondaryPath = simple?.ctaSecondaryHref ?? page.ctaSecondaryHref;
const galleryTitle = simple?.galleryTitle ?? 'In-game look'; const introEditByPage: Partial<Record<PageId, string>> = { features: 'featuresIntro', pricing: 'storeIntro', updates: 'statusIntro', hacks: 'previewIntro', setup: 'setupIntro', support: 'supportIntro', faq: 'faqIntro',
};
const introEdit = locale === 'en' ? introEditByPage[pageId] : undefined;
const gallery = deltaForceImages.product.slice(0, 3).map((img) => ({ src: img.src, alt: img.alt,
})); const faqSchema = pageId === 'faq' && locale === 'en' ? { '@context': 'https://schema.org', '@type': 'FAQPage', '@id': `${new URL(getLocalizedPath('faq', locale), siteConfig.url).href}#faq`, mainEntity: seoFaqs.map((item) => ({ '@type': 'Question', name: item.question, url: absoluteFaqUrl(item.slug), acceptedAnswer: { '@type': 'Answer', text: item.answer }, })), } : null; const ctaSecondaryHref = ctaSecondaryPath ? localizeInternalHref(ctaSecondaryPath, locale) : ctaSecondaryLabel ? siteConfig.checkoutUrl : getLocalizedPath('features', locale); const monthly = productInfo.plans.find((p) => p.id === 'monthly') ?? productInfo.plans[0];
const lifetime = productInfo.plans.find((p) => p.id === 'lifetime') ?? productInfo.plans[1];
const showStorePlans = pageId === 'pricing' && locale === 'en'; const eyebrowByPage: Partial<Record<PageId, string>> = { features: 'Features', pricing: 'Store', updates: 'Status', hacks: 'Preview',
};
--- <PageLayout title={simple?.title ?? page.title} description={simple?.description ?? page.description} canonicalPath={getLocalizedPath(pageId, locale)} heading={heading} intro={intro} introEdit={introEdit} eyebrow={eyebrowByPage[pageId]} heroImage={siteConfig.heroImage || deltaForceImages.hero} heroAlt={siteConfig.name} gallery={gallery} galleryTitle={galleryTitle} locale={locale} pageId={pageId} ctaPrimary={{ href: siteConfig.checkoutUrl, label: ctaPrimaryLabel, edit: 'ctaBuy' }} ctaSecondary={ ctaSecondaryLabel ? { href: ctaSecondaryHref, label: ctaSecondaryLabel } : undefined }
> {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />} { showStorePlans && ( <section class="card-panel"> <h2>Plans</h2> <div class="price-grid"> <a class="price-card" href={siteConfig.checkoutUrl} rel="noopener noreferrer"> <span class="price-card__label">Monthly</span> <span class="price-card__price">${monthly.price}</span> <span class="price-card__meta">30 days</span> </a> <a class="price-card is-featured" href={siteConfig.checkoutUrl} rel="noopener noreferrer"> <span class="price-card__label">Lifetime</span> <span class="price-card__price">${lifetime.price}</span> <span class="price-card__meta">One-time</span> </a> </div> </section> ) } { sections.map((section) => ( <section class="card-panel"> <h2>{section.h2}</h2> {section.paragraphs.map((p) => ( <p set:html={localizeParagraphHtml(p)} /> ))} {section.list && ( <ul> {section.list.map((item) => ( <li set:html={localizeParagraphHtml(item)} /> ))} </ul> )} </section> )) } { pageId === 'faq' && locale === 'en' && ( <section class="card-panel faq-index"> <h2>All questions</h2> <p>Open any question for the full answer.</p> <ul class="faq-index__list"> {seoFaqs.map((item) => ( <li> <a href={getFaqPath(item.slug)}> <span>{item.question}</span> <span aria-hidden="true">→</span> </a> </li> ))} </ul> </section> ) }
</PageLayout> <style>.faq-index__list { margin: 1rem 0 0; padding: 0; list-style: none; display: grid; gap: 0.45rem; }.faq-index__list a { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 0.85rem 1rem; border: 1px solid var(--line); border-radius: var(--radius-md, 0.75rem); background: var(--bg-elevated); color: var(--ink); font-weight: 600; text-decoration: none; transition: border-color 0.2s ease, color 0.2s ease; }.faq-index__list a:hover { border-color: color-mix(in srgb, var(--magenta) 35%, var(--line)); color: var(--magenta-soft); }
</style>
