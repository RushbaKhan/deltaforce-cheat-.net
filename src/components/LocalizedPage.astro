---
import PageLayout from '../layouts/PageLayout.astro';
import { getPageContent, getUi, type PageId } from '../data/i18n';
import { getLocalizedPath, localizeInternalHref } from '../data/i18n/routing';
import type { LocaleCode } from '../data/i18n/locales';
import { productInfo, seoFaqs, siteConfig, customerReviewStats } from '../data/site';
import { absoluteFaqUrl, getFaqPath } from '../data/faq';
import { deltaForceImages } from '../data/delta-force';
import { simplePageCopy } from '../data/i18n/simple-pages';
import { getT } from '../i18n/server';
import { getPageCrawlImage } from '../data/page-images';

interface Props {
	locale: LocaleCode;
	pageId: PageId;
}

const { locale, pageId } = Astro.props;
const page = getPageContent(locale, pageId);
const ui = getUi(locale);
const t = getT(locale);
const crawl = getPageCrawlImage(pageId);
const simple = locale === 'en' ? simplePageCopy[pageId] : undefined;

function localizeParagraphHtml(html: string): string {
	return html
		.replace(/\{checkout\}/g, siteConfig.checkoutUrl)
		.replace(/href="(\/[^"]+)"/g, (_, path: string) => `href="${localizeInternalHref(path, locale)}"`);
}

const heading = simple?.h1 ?? page.h1;
const intro = simple?.intro ?? page.intro;
const sections = simple?.sections ?? page.sections;
const ctaPrimaryLabel = simple?.ctaPrimary ?? page.ctaPrimary;
const ctaSecondaryLabel = simple?.ctaSecondary ?? page.ctaSecondary;
const ctaSecondaryPath = simple?.ctaSecondaryHref ?? page.ctaSecondaryHref;
const galleryTitle = simple?.galleryTitle ?? page.galleryTitle ?? t('common.inGameLook');

const introEditByPage: Partial<Record<PageId, string>> = {
	features: 'featuresIntro',
	pricing: 'storeIntro',
	updates: 'statusIntro',
	hacks: 'previewIntro',
	setup: 'setupIntro',
	support: 'supportIntro',
	faq: 'faqIntro',
};
const introEdit = locale === 'en' ? introEditByPage[pageId] : undefined;
const gallery = [
	{ src: crawl.src, alt: page.imageAlt || crawl.caption },
	...deltaForceImages.product.slice(0, 2).map((img) => ({
		src: img.src,
		alt: img.alt,
	})),
];

const pageUrl = new URL(getLocalizedPath(pageId, locale), siteConfig.url).href;
const priceValidUntil = '2027-12-31';

const faqSchema =
	pageId === 'faq' && locale === 'en'
		? {
				'@type': 'FAQPage',
				'@id': `${pageUrl}#faq`,
				mainEntity: seoFaqs.map((item) => ({
					'@type': 'Question',
					name: item.question,
					url: absoluteFaqUrl(item.slug),
					acceptedAnswer: { '@type': 'Answer', text: item.answer },
				})),
			}
		: null;

const storeSchema =
	pageId === 'pricing' || pageId === 'hacks'
		? {
				'@type': 'Product',
				'@id': `${pageUrl}#product`,
				name: productInfo.name,
				description: productInfo.summary,
				image: crawl.url,
				brand: { '@type': 'Brand', name: productInfo.brand },
				url: new URL('/delta-force-cheats/', siteConfig.url).href,
				aggregateRating: {
					'@type': 'AggregateRating',
					ratingValue: customerReviewStats.averageRating.toFixed(1),
					reviewCount: String(customerReviewStats.totalCount),
					bestRating: '5',
					worstRating: '1',
				},
				offers: {
					'@type': 'AggregateOffer',
					lowPrice: Math.min(...productInfo.plans.map((p) => p.price)).toFixed(2),
					highPrice: Math.max(...productInfo.plans.map((p) => p.price)).toFixed(2),
					priceCurrency: productInfo.currency,
					offerCount: productInfo.plans.length,
					availability: 'https://schema.org/InStock',
					url: siteConfig.checkoutUrl,
					offers: productInfo.plans.map((plan) => ({
						'@type': 'Offer',
						name: `${productInfo.name} ${plan.label}`,
						price: plan.price.toFixed(2),
						priceCurrency: productInfo.currency,
						priceValidUntil,
						availability: 'https://schema.org/InStock',
						url: siteConfig.checkoutUrl,
						seller: { '@id': `${siteConfig.url}/#organization` },
					})),
				},
			}
		: null;

const extraGraph = [faqSchema, storeSchema].filter(Boolean) as Record<string, unknown>[];

const ctaSecondaryHref = ctaSecondaryPath
	? localizeInternalHref(ctaSecondaryPath, locale)
	: ctaSecondaryLabel
		? siteConfig.checkoutUrl
		: getLocalizedPath('features', locale);

const monthly = productInfo.plans.find((p) => p.id === 'monthly') ?? productInfo.plans[0];
const lifetime = productInfo.plans.find((p) => p.id === 'lifetime') ?? productInfo.plans[1];
const showStorePlans = pageId === 'pricing' && locale === 'en';

const eyebrowByPage: Partial<Record<PageId, string>> = {
	features: ui.nav.features,
	pricing: ui.nav.pricing,
	updates: ui.nav.updates,
	hacks: locale === 'en' ? t('nav.preview') : ui.nav.hacks,
	'tarkov-esp': ui.nav.esp,
	'tarkov-aimbot': ui.nav.aimbot,
	radar: 'Radar',
	setup: ui.nav.setup,
	faq: ui.nav.faq,
};
---

<PageLayout
	title={simple?.title ?? page.title}
	description={simple?.description ?? page.description}
	canonicalPath={getLocalizedPath(pageId, locale)}
	heading={heading}
	intro={intro}
	introEdit={introEdit}
	eyebrow={eyebrowByPage[pageId]}
	heroImage={crawl.src}
	heroAlt={page.imageAlt || crawl.caption}
	gallery={gallery}
	galleryTitle={galleryTitle}
	locale={locale}
	pageId={pageId}
	extraGraph={extraGraph}
	ctaPrimary={{ href: siteConfig.checkoutUrl, label: ctaPrimaryLabel, edit: 'ctaBuy' }}
	ctaSecondary={
		ctaSecondaryLabel
			? { href: ctaSecondaryHref, label: ctaSecondaryLabel }
			: undefined
	}
>
	{/* JSON-LD is emitted via PageLayout → Layout extraGraph */}

	{
		showStorePlans && (
			<section class="card-panel">
				<h2>{t('product.plans')}</h2>
				<div class="price-grid">
					<a class="price-card" href={siteConfig.checkoutUrl} rel="noopener noreferrer">
						<span class="price-card__label">{t('product.monthly')}</span>
						<span class="price-card__price">${monthly.price}</span>
						<span class="price-card__meta">{t('product.days30')}</span>
					</a>
					<a class="price-card is-featured" href={siteConfig.checkoutUrl} rel="noopener noreferrer">
						<span class="price-card__label">{t('product.lifetime')}</span>
						<span class="price-card__price">${lifetime.price}</span>
						<span class="price-card__meta">{t('product.oneTime')}</span>
					</a>
				</div>
			</section>
		)
	}

	{
		sections.map((section) => (
			<section class="card-panel">
				<h2>{section.h2}</h2>
				{section.paragraphs.map((p) => (
					<p set:html={localizeParagraphHtml(p)} />
				))}
				{section.list && (
					<ul>
						{section.list.map((item) => (
							<li set:html={localizeParagraphHtml(item)} />
						))}
					</ul>
				)}
			</section>
		))
	}

	{
		pageId === 'faq' && locale === 'en' && (
			<section class="card-panel faq-index">
				<h2>{t('common.allQuestions')}</h2>
				<p>{t('common.openAnyQuestion')}</p>
				<ul class="faq-index__list">
					{seoFaqs.map((item) => (
						<li>
							<a href={getFaqPath(item.slug)}>
								<span>{item.question}</span>
								<span aria-hidden="true">→</span>
							</a>
						</li>
					))}
				</ul>
			</section>
		)
	}
</PageLayout>

<style>
	.faq-index__list {
		margin: 1rem 0 0;
		padding: 0;
		list-style: none;
		display: grid;
		gap: 0.45rem;
	}

	.faq-index__list a {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.85rem 1rem;
		border: 1px solid var(--line);
		border-radius: var(--radius-md, 0.75rem);
		background: var(--bg-elevated);
		color: var(--ink);
		font-weight: 600;
		text-decoration: none;
		transition:
			border-color 0.2s ease,
			color 0.2s ease;
	}

	.faq-index__list a:hover {
		border-color: color-mix(in srgb, var(--magenta) 35%, var(--line));
		color: var(--magenta-soft);
	}
</style>
