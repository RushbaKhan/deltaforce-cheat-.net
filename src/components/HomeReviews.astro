---
import HomeReviewsApp from './react/HomeReviews';
import { customerReviews, customerReviewStats } from '../data/site';
import { getReviewPath, reviewsBasePath } from '../data/reviews';
import { defaultLocale, type LocaleCode } from '../data/i18n/locales';

interface Props {
	locale?: LocaleCode;
}

const locale = Astro.props.locale ?? defaultLocale;
const reviews = customerReviews.map((review) => ({
	slug: review.slug,
	handle: review.handle,
	text: review.text,
	short: review.short,
	date: review.date,
	rating: review.rating,
	href: getReviewPath(review.slug),
}));
---

<HomeReviewsApp
	client:visible
	locale={locale}
	reviews={reviews}
	averageRating={customerReviewStats.averageRating}
	totalCount={customerReviewStats.totalCount}
	reviewsBasePath={reviewsBasePath}
/>

<style is:global>
	.reviews {
		padding-block: clamp(3rem, 6vw, 4.5rem) clamp(2.5rem, 5vw, 3.5rem);
		background: var(--bg);
		border-top: 1px solid var(--line-soft);
		overflow: hidden;
	}

	.reviews__head {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 1.5rem 2rem;
		margin: 0 0 1.75rem;
		padding-bottom: 1.35rem;
		border-bottom: 1px solid var(--line-soft);
	}

	.reviews__head-copy {
		max-width: none;
		min-width: 0;
	}

	.reviews__eyebrow {
		margin: 0 0 0.4rem;
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--magenta-soft);
	}

	.reviews__head h2 {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(1.05rem, 1.8vw, 1.2rem);
		font-weight: 700;
		letter-spacing: -0.02em;
		line-height: 1.25;
		color: var(--ink);
	}

	.reviews__score {
		display: flex;
		align-items: center;
		gap: 0.85rem;
		flex-shrink: 0;
		margin-top: 0;
		padding: 0.7rem 0.95rem;
		border: 1px solid var(--line);
		border-radius: var(--radius-md);
		background: var(--bg-panel);
	}

	.reviews__score strong {
		font-family: var(--font-display);
		font-size: 2rem;
		font-weight: 800;
		letter-spacing: -0.04em;
		line-height: 1;
		color: var(--ink);
	}

	.reviews__stars {
		display: flex;
		gap: 0.12rem;
		color: var(--magenta-soft);
	}

	.reviews__stars svg {
		width: 0.85rem;
		height: 0.85rem;
	}

	.reviews__score p {
		margin: 0.25rem 0 0;
		font-size: 0.75rem;
		color: var(--ink-faint);
		white-space: nowrap;
	}

	.reviews__marquee {
		position: relative;
		mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
		-webkit-mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
		content-visibility: auto;
		contain-intrinsic-size: 1px 220px;
	}

	.reviews__track {
		display: flex;
		width: max-content;
		animation: reviews-ltr 70s linear infinite;
		will-change: transform;
	}

	.reviews__row {
		display: flex;
		gap: 0.85rem;
		margin: 0;
		padding: 0.35rem 0.85rem 0.35rem 0;
		list-style: none;
	}

	.reviews__row > li {
		flex: 0 0 auto;
		width: min(20.5rem, 78vw);
	}

	.reviews__marquee:hover .reviews__track,
	.reviews__marquee:focus-within .reviews__track {
		animation-play-state: paused;
	}

	@media (max-width: 760px) {
		.reviews__head {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.85rem;
		}

		.reviews__score {
			width: 100%;
			justify-content: flex-start;
		}

		.reviews__score p {
			white-space: normal;
		}

		.reviews__marquee {
			mask-image: none;
			-webkit-mask-image: none;
			overflow-x: auto;
			-webkit-overflow-scrolling: touch;
			scroll-snap-type: x mandatory;
			scrollbar-width: none;
		}

		.reviews__marquee::-webkit-scrollbar {
			display: none;
		}

		.reviews__track {
			animation: none;
		}

		.reviews__row[aria-hidden='true'] {
			display: none;
		}

		.reviews__row {
			padding-inline: var(--page-gutter);
			gap: 0.75rem;
		}

		.reviews__row > li {
			width: min(18.5rem, 82vw);
			scroll-snap-align: start;
		}

		.review-card {
			min-height: 0;
		}

		a.review-card__name {
			min-height: 2.5rem;
			display: inline-flex;
			align-items: center;
		}
	}

	@media (max-width: 480px) {
		.reviews {
			padding-block: 2.25rem 2rem;
		}

		.reviews__row > li {
			width: min(17rem, 86vw);
		}
	}

	.review-card {
		display: flex;
		flex-direction: column;
		height: 100%;
		min-height: 11.5rem;
		padding: 1.2rem 1.15rem 1.1rem;
		border: 1px solid var(--line);
		border-radius: var(--radius-md);
		background: var(--bg-panel);
		transition: border-color 0.2s ease, background 0.2s ease, transform 0.2s ease;
	}

	.review-card:hover {
		border-color: color-mix(in srgb, var(--magenta) 35%, var(--line));
		background: var(--bg-elevated);
		transform: translateY(-2px);
	}

	.review-card__text {
		margin: 0;
		flex: 1;
		font-size: 0.9rem;
		line-height: 1.55;
		color: var(--ink-muted);
	}

	.review-card__foot {
		display: grid;
		grid-template-columns: auto 1fr auto;
		align-items: center;
		gap: 0.7rem;
		margin-top: 1.15rem;
		padding-top: 0.95rem;
		border-top: 1px solid var(--line-soft);
	}

	.review-card__avatar {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2rem;
		height: 2rem;
		border-radius: 999px;
		background: color-mix(in srgb, var(--magenta) 16%, var(--bg-elevated));
		border: 1px solid color-mix(in srgb, var(--magenta) 28%, var(--line));
		font-size: 0.8rem;
		font-weight: 700;
		color: var(--magenta-soft);
	}

	.review-card__name {
		display: block;
		font-size: 0.875rem;
		font-weight: 600;
		color: var(--ink);
		line-height: 1.2;
		text-decoration: none;
	}

	a.review-card__name:hover {
		color: var(--magenta-soft);
	}

	.review-card__foot time {
		display: block;
		margin-top: 0.15rem;
		font-size: 0.75rem;
		color: var(--ink-faint);
	}

	.review-card__rating {
		font-size: 0.75rem;
		font-weight: 600;
		color: var(--magenta-soft);
		white-space: nowrap;
	}

	.reviews__more {
		margin: 1.5rem 0 0;
		text-align: center;
	}

	.reviews__more a {
		font-size: 0.875rem;
		font-weight: 500;
		color: var(--ink-muted);
	}

	.reviews__more a:hover {
		color: var(--magenta-soft);
	}

	@keyframes reviews-ltr {
		from {
			transform: translateX(-50%);
		}
		to {
			transform: translateX(0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.reviews__track {
			animation: none;
			flex-wrap: wrap;
			width: 100%;
			max-width: var(--page-max);
			margin-inline: auto;
			justify-content: center;
			padding-inline: var(--page-gutter);
		}

		.reviews__row[aria-hidden='true'] {
			display: none;
		}

		.reviews__marquee {
			mask-image: none;
			-webkit-mask-image: none;
		}

		.review-card:hover {
			transform: none;
		}
	}
</style>
