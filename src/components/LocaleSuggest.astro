---
import { locales, defaultLocale, type LocaleCode } from '../data/i18n/locales';
import { localizedSlugs, type PageId } from '../data/i18n/routing';

interface Props {
	currentLocale: LocaleCode;
	pageId?: PageId;
}

const { currentLocale, pageId = 'home' } = Astro.props;

if (currentLocale !== defaultLocale) {
	return null;
}

const localeList = JSON.stringify(
	locales.map((l) => ({
		code: l.code,
		nativeName: l.nativeName,
		region: l.region,
		name: l.name,
	})),
);
// Only ship the slug map for this page — the full map for all pages/locales
// added ~20KB of inline JSON to every English page.
const pageSlugs = JSON.stringify(localizedSlugs[pageId] ?? {});
---

<div class="locale-suggest is-hidden" role="region" aria-label="Language suggestion" hidden>
	<p class="locale-suggest__text"></p>
	<button type="button" class="locale-suggest__dismiss" aria-label="Dismiss">×</button>
</div>

<script define:vars={{ localeList, pageSlugs, defaultLocale }}>
	(function () {
		const run = () => {
			const bar = document.querySelector('.locale-suggest');
			const textEl = bar?.querySelector('.locale-suggest__text');
			const dismiss = bar?.querySelector('.locale-suggest__dismiss');
			const storageKey = 'fc_locale_dismissed';
			const cookieName = 'fc_locale';

			if (!bar || sessionStorage.getItem(storageKey)) return;

			const locales = JSON.parse(localeList);
			const slugs = JSON.parse(pageSlugs);

			function getLocalizedPath(locale) {
				const slug = slugs[locale];
				return slug ? `/${locale}/${slug}/` : `/${locale}/`;
			}

			function localeFromNavigator() {
				const cookie = document.cookie.match(/(?:^|;\s*)fc_locale=([^;]+)/)?.[1];
				if (cookie && locales.some((l) => l.code === cookie)) return cookie;

				const langs = navigator.languages?.length ? navigator.languages : [navigator.language];
				for (const tag of langs) {
					const primary = tag.toLowerCase().split('-')[0];
					if (locales.some((l) => l.code === primary)) return primary;
				}
				return defaultLocale;
			}

			const preferred = localeFromNavigator();
			if (preferred === defaultLocale) return;

			const target = locales.find((l) => l.code === preferred);
			if (!target || !textEl) return;

			const href = getLocalizedPath(preferred);
			textEl.replaceChildren();
			textEl.append(
				document.createTextNode(`${target.nativeName} (${target.region}) — `),
			);
			const link = document.createElement('a');
			link.href = href;
			link.textContent = `${target.name} version`;
			textEl.append(link);
			bar.hidden = false;
			bar.classList.remove('is-hidden');

			dismiss?.addEventListener('click', () => {
				sessionStorage.setItem(storageKey, '1');
				bar.hidden = true;
			});

			link.addEventListener('click', () => {
				document.cookie = `${cookieName}=${preferred};path=/;max-age=31536000;SameSite=Lax`;
			});
		};

		if ('requestIdleCallback' in window) {
			requestIdleCallback(run, { timeout: 3000 });
		} else {
			setTimeout(run, 1);
		}
	})();
</script>

<style>
	.locale-suggest {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.75rem;
		padding: 0.55rem 1rem;
		background: color-mix(in srgb, var(--magenta) 14%, var(--bg));
		border-bottom: 1px solid color-mix(in srgb, var(--magenta) 25%, var(--line));
		font-size: 0.82rem;
		color: var(--ink-muted);
		text-align: center;
	}

	.locale-suggest.is-hidden {
		display: none;
	}

	.locale-suggest__text {
		margin: 0;
	}

	.locale-suggest :global(a) {
		color: var(--magenta-soft);
		font-weight: 700;
		text-decoration: underline;
	}

	.locale-suggest__dismiss {
		border: none;
		background: transparent;
		color: var(--ink-faint);
		font-size: 1.2rem;
		line-height: 1;
		cursor: pointer;
		padding: 0.15rem 0.35rem;
	}
</style>
