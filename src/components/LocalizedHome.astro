---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import HomeReviews from '../components/HomeReviews.astro';
import HomeSeo from '../components/HomeSeo.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { getLocaleContent, getPageContent } from '../data/i18n';
import { getLocalizedPath } from '../data/i18n/routing';
import type { LocaleCode } from '../data/i18n/locales';
import { homeFaqs, homeSeo, productInfo, siteConfig, seoKeywords, customerReviewStats, customerReviews } from '../data/site';
import { deltaForceImages } from '../data/delta-force';
import { heroPreloadSrc, heroSizes, heroSrcSet } from '../lib/responsive-images'; interface Props { locale: LocaleCode;
} const { locale } = Astro.props;
const { ui } = getLocaleContent(locale);
const home = getPageContent(locale, 'home');
const enHome = homeSeo(); const title = locale === 'en' ? enHome.title : home.title;
const description = locale === 'en' ? enHome.description : home.description;
const canonicalPath = getLocalizedPath('home', locale);
const canonicalURL = new URL(canonicalPath, siteConfig.url).href;
const heroImage = new URL(siteConfig.heroImage || deltaForceImages.hero, siteConfig.url).href;
const priceValidUntil = '2027-12-31'; const extraGraph: Record<string, unknown>[] = [ { '@type': 'Product', '@id': `${canonicalURL}#product`, name: productInfo.name, description: productInfo.summary, image: heroImage, brand: { '@type': 'Brand', name: productInfo.brand }, url: canonicalURL, aggregateRating: { '@type': 'AggregateRating', ratingValue: customerReviewStats.averageRating.toFixed(1), reviewCount: customerReviewStats.totalCount, bestRating: '5', worstRating: '1', }, review: customerReviews.slice(0, 3).map((review) => ({ '@type': 'Review', author: { '@type': 'Person', name: review.handle }, datePublished: review.date, reviewRating: { '@type': 'Rating', ratingValue: String(review.rating), bestRating: '5', worstRating: '1', }, reviewBody: review.text, })), }, { '@type': 'SoftwareApplication', '@id': `${canonicalURL}#software`, name: productInfo.name, applicationCategory: 'GameApplication', operatingSystem: 'Windows', description: productInfo.summary, url: canonicalURL, image: heroImage, brand: { '@type': 'Brand', name: productInfo.brand }, keywords: seoKeywords.join(', '), offers: { '@type': 'AggregateOffer', lowPrice: Math.min(...productInfo.plans.map((p) => p.price)).toFixed(2), highPrice: Math.max(...productInfo.plans.map((p) => p.price)).toFixed(2), priceCurrency: productInfo.currency, offerCount: productInfo.plans.length, offers: productInfo.plans.map((plan) => ({ '@type': 'Offer', name: `${productInfo.name} ${plan.label}`, price: plan.price.toFixed(2), priceCurrency: productInfo.currency, priceValidUntil, availability: 'https://schema.org/InStock', url: siteConfig.checkoutUrl, seller: { '@id': `${siteConfig.url}/#organization` }, })), }, }, { '@type': 'FAQPage', '@id': `${canonicalURL}#faq`, mainEntity: homeFaqs.map((item) => ({ '@type': 'Question', name: item.question, url: `${siteConfig.url}/faq/${item.slug}/`, acceptedAnswer: { '@type': 'Answer', text: item.answer, }, })), },
];
--- <Layout title={title} description={description} canonicalPath={canonicalPath} ogImage={siteConfig.defaultOgImage} ogImageAlt={home.imageAlt} locale={locale} pageId="home" breadcrumbs={[{ label: ui.nav.home }]} extraGraph={locale === 'en' ? extraGraph : extraGraph.filter((n) => n['@type'] !== 'FAQPage')} lcpImage={heroPreloadSrc} lcpImageSrcSet={heroSrcSet} lcpImageSizes={heroSizes}
> <Navbar locale={locale} pageId="home" /> <main class="home"> <Hero locale={locale} /> <HomeReviews /> <div class="home__seo"> { locale === 'en' ? ( <HomeSeo /> ) : ( <div class="shell home__prose"> <h2>{home.h1}</h2> <p>{home.intro}</p> { home.sections.map((section) => ( <div> <h3>{section.h2}</h3> {section.paragraphs.map((p) => ( <p set:html={p} /> ))} </div> )) } </div> ) } </div> <SiteFooter locale={locale} /> </main>
</Layout> <style>.home { width: 100%; overflow-x: clip; }.home__seo { border-top: 1px solid var(--line-soft); background: var(--bg-panel); }.home__prose { padding-block: var(--section-space); color: var(--ink-muted); line-height: 1.65; font-size: 0.9375rem; }.home__prose h2 { margin: 0 0 0.75rem; font-family: var(--font-display); font-size: 1.5rem; letter-spacing: -0.03em; color: var(--ink); }.home__prose h3 { margin: 1.25rem 0 0.5rem; font-size: 1rem; color: var(--ink); }
</style>
