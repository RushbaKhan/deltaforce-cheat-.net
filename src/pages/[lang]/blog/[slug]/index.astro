---
/**
 * Locale blog posts are English clones — 301 to the EN slug.
 * Avoids fake hreflang clusters and duplicate content.
 */
import { blogPosts, findPostBySlug, getBlogPostPath } from '../../../../data/blog/helpers';
import { defaultLocale, isLocaleCode, localeCodes, type LocaleCode } from '../../../../data/i18n/locales';

export function getStaticPaths() {
	const paths: {
		params: { lang: string; slug: string };
		props: { locale: LocaleCode };
	}[] = [];

	for (const locale of localeCodes) {
		if (locale === defaultLocale) continue;
		for (const post of blogPosts) {
			const slug = post.translations[locale].slug;
			paths.push({
				params: { lang: locale, slug },
				props: { locale },
			});
		}
	}

	return paths;
}

const { locale } = Astro.props;
const slug = Astro.params.slug ?? '';

if (!isLocaleCode(Astro.params.lang ?? '')) {
	return Astro.redirect('/blog/', 301);
}

const post = findPostBySlug(slug, locale) ?? findPostBySlug(slug);
const enSlug = post?.translations[defaultLocale].slug;
if (!enSlug) {
	return Astro.redirect('/blog/', 301);
}

return Astro.redirect(getBlogPostPath(defaultLocale, enSlug), 301);
---
