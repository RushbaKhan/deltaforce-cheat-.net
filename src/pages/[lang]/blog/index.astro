---
import BlogIndexPage from '../../../components/BlogIndexPage.astro';
import { defaultLocale, isLocaleCode, localeCodes } from '../../../data/i18n/locales'; export function getStaticPaths() { return localeCodes.filter((code) => code !== defaultLocale).map((lang) => ({ params: { lang }, props: { locale: lang } }));
} const { locale } = Astro.props; if (!isLocaleCode(Astro.params.lang ?? '')) { return Astro.redirect('/');
}
--- <BlogIndexPage locale={locale} />
